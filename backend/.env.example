# OmniPharma Backend — Environment Variables
# Copy to .env and fill in values before running.

# Runtime environment: development | staging | production
APP_ENV=development

# SQLAlchemy connection string for the main patient/rules database.
DATABASE_URL=sqlite:///./data/omnipharm.db

# SQLAlchemy connection string for the PPB drug catalogue database.
PPB_DATABASE_URL=sqlite:///./data/ppb_drugs.db

# LLM provider adapter: openai | google | (leave blank to disable LLM explanation)
LLM_PROVIDER=

# API key for the selected LLM provider (not required when LLM_PROVIDER is blank).
LLM_API_KEY=

# Optional: openFDA API key for higher rate limits on evidence lookups.
OPENFDA_API_KEY=

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins.
# Add your frontend URL here (e.g. http://localhost:5173 for Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Version tag embedded in every ScreeningResponse.
RULESET_VERSION=demo-1.0

# Set to true to exclude out-of-stock candidates from recommendations.
INVENTORY_AWARE=false

# Per-source HTTP timeout in seconds for evidence retrieval.
EVIDENCE_TIMEOUT_SECONDS=5.0
